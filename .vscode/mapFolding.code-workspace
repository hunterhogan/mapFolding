{
	"folders": [
		{
			"path": ".."
		}
	],
	"settings": {
		"editor.fontFamily": "\"Integrated Code 火 简化字\", \"Integrated Code 火 한국인\", \"Integrated Code 火 日本\", \"Integrated Code 火 台灣\", \"Integrated Code 火 香港\", \"Sarasa Mono SC\", \"Sarasa Mono K\", \"Sarasa Mono J\", \"Sarasa Mono TC\", \"Sarasa Mono HC\", \"Sarasa Mono CL\", \"Maple Mono\", \"Maple Mono NF\", \"Maple Mono CN\", \"Maple Mono NF CN\", monospace",
		"editor.fontLigatures": true,
		"workbench.editorAssociations": {
			"*.copilotmd": "vscode.markdown.preview.editor",
		},
		"python.testing.pytestArgs": [
			"mapFolding"
		],
		"python.testing.unittestEnabled": false,
		"python.testing.pytestEnabled": true,
		"cSpell.customDictionaries": {
			"custom": true, // Enable the `custom` dictionary
			"internal-terms": false, // Disable the `internal-terms` dictionary
			"project-words": {
				"addWords": true,
				"description": "Words used in this workspace.",
				"name": "project-words",
				"path": "${workspaceFolder}/.vscode/code-spell-dictionary-workspace.txt"
			},
		},
	},
	"extensions": {
		"recommendations": [
			"streetsidesoftware.code-spell-checker",
			"editorconfig.editorconfig",
			"charliermarsh.ruff",
			"DavidAnson.vscode-markdownlint",
			"ms-python.isort",
			"tombi-toml.tombi",
		]
	}
}
